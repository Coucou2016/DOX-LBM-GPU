cff-version: 1.2.0
title: "Fibrosis-Reentry-MS2D (DOX-LBM-GPU): wavelength-aware 2D monodomain benchmark"
message: "If you use this software, please cite it as below."
type: software
authors:
  # Placeholder structure until named authors are finalized for submission.
  - family-names: "[Author]"
    given-names: "[Given]"
    affiliation: "[Affiliation to be completed]"
  - name: "DOX-LBM-GPU / Fibrosis-Reentry-MS2D contributors"
repository-code: "https://github.com/Coucou2016/DOX-LBM-GPU"
url: "https://github.com/Coucou2016/DOX-LBM-GPU"
license: MIT
abstract: >-
  Open CPU 2D finite-difference monodomain protocol/benchmark aligned with
  λ-modified Mitchell–Schaeffer choices from Villar-Valero et al. (DOX-inspired).
  Triple VA endpoints (persist-only, recurrence, strict) and wavelength-aware
  verification geometry. Not a 3D LBM–GPU digital-twin reproduction.
keywords:
  - cardiac electrophysiology
  - Mitchell-Schaeffer
  - monodomain
  - fibrosis
  - reentry
  - reproducibility
# preferred-citation is THIS software (not the Villar-Valero biology paper).
preferred-citation:
  type: software
  authors:
