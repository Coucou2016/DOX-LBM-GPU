      given-names: "[Given]"
    - name: "DOX-LBM-GPU / Fibrosis-Reentry-MS2D contributors"
  title: "Fibrosis-Reentry-MS2D (DOX-LBM-GPU): wavelength-aware 2D monodomain benchmark"
  year: 2026
  url: "https://github.com/Coucou2016/DOX-LBM-GPU"
